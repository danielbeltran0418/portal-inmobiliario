# ============================================================================
# VARIABLES DE ENTORNO — PORTAL INMOBILIARIO
# ============================================================================
# Copiar este archivo a .env.local para desarrollo o configurar en Vercel / CI.
# Todas las variables que lee el codigo (src/ y scripts/) estan documentadas aqui.
# Los valores se dejan vacios intencionalmente.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# URL publica de la API del proyecto Supabase (acceso a REST, Auth y Storage).
# Secreta: NO (publica por diseño, expuesta al cliente con prefijo NEXT_PUBLIC_).
# Si falta: Los clientes de Supabase (browser y server) fallan al instanciarse; la app no puede consultar datos ni autenticar usuarios.
NEXT_PUBLIC_SUPABASE_URL=

# Clave publica anonima de Supabase.
# Secreta: NO (publica por diseño, expuesta al cliente con prefijo NEXT_PUBLIC_; la seguridad depende estrictamente de RLS).
# Si falta: Las peticiones a Supabase no pueden autenticarse y fallan inmediatamente.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de superusuario con rol de servicio de Supabase (service_role).
# Secreta: SI (ALTAMENTE SECRETA, SOLO SERVIDOR. NUNCA con prefijo NEXT_PUBLIC_ porque salta RLS por completo).
# Si falta: Fallan las operaciones administrativas que requieren saltar RLS (cliente-admin.ts, scripts de sembrado y mantenimiento).
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexion directa a Postgres (ej. postgresql://postgres:postgres@127.0.0.1:54322/postgres).
# Secreta: SI (SECRETA, SOLO SERVIDOR. Contiene credenciales directas a la base de datos).
# Si falta: Falla la conexion directa usada exclusivamente en pruebas RLS y verificacion de la guarda del seed.
SUPABASE_DB_URL=

# Identificador del entorno de ejecucion ('local', 'production', etc.).
# Secreta: NO (solo servidor/scripts).
# Si falta: Se asume entorno no productivo; con valor 'production' bloquea estrictamente la ejecucion del seed para proteger datos reales.
APP_ENTORNO=

# --- Aplicacion y Navegacion ------------------------------------------------
# URL base publica absoluta de la aplicacion (ej. https://portal-inmobiliario-alpha.vercel.app o http://127.0.0.1:3000).
# Secreta: NO (publica, prefijo NEXT_PUBLIC_).
# Si falta: Degrada a 'http://127.0.0.1:3000' o URL vacia; los correos de confirmacion (emailRedirectTo) y enlaces canonicos de SEO pueden salir rotos.
NEXT_PUBLIC_APP_URL=

# --- Captcha (Cloudflare Turnstile) -----------------------------------------
# Clave publica del sitio para el widget de Turnstile en formularios de registro y login.
# Secreta: NO (clave publica consumida por el widget cliente).
# Si falta: Turnstile queda DESACTIVADO (se requieren ambas claves: SITE y SECRET; si falta una o ambas, se emite aviso y los formularios operan sin captcha).
TURNSTILE_SITE_KEY=

# Clave secreta de Cloudflare Turnstile para validar el token del captcha contra la API de Cloudflare en el servidor.
# Secreta: SI (SOLO SERVIDOR, NUNCA con prefijo NEXT_PUBLIC_).
# Si falta: Turnstile queda DESACTIVADO.
TURNSTILE_SECRET_KEY=

# --- Seguridad y Red --------------------------------------------------------
# Nombre de la cabecera HTTP que la plataforma garantiza reescribir con la IP real del cliente (en Vercel: x-vercel-forwarded-for).
# Secreta: NO (nombre de cabecera en servidor).
# Si falta: Fuera de produccion (local/test) la IP se fija en 127.0.0.1. En produccion, el limite de intentos degrada a ventana por correo
# (mas estricto y no falsificable) registrando un aviso en los logs; el registro de nuevos usuarios se bloquea en produccion si no hay cabecera confiable.
IP_CABECERA_CONFIABLE=

# --- Correo Transaccional (Resend) ------------------------------------------
# Clave de API de Resend para el envio de emails (notificaciones de busquedas guardadas y avisos de citas).
# Secreta: SI (SOLO SERVIDOR, NUNCA con prefijo NEXT_PUBLIC_).
# Si falta: El cron /api/cron/notificar-busquedas responde 500 sin procesar envios; los avisos de citas no se envian y registran advertencia en logs.
RESEND_API_KEY=

# Direccion de remitente verificada en Resend (formato: Portal Inmobiliario <alertas@tu-dominio.com>).
# Secreta: NO (configuracion de remitente en servidor).
# Si falta: El cron de notificaciones responde 500. Sin un dominio verificado en Resend (https://resend.com/domains), Resend solo entrega correos a la direccion de la cuenta propietaria.
RESEND_FROM=

# --- Tareas Programadas (Vercel Cron) ---------------------------------------
# Secreto para autorizar llamadas a rutas /api/cron/* mediante cabecera Authorization: Bearer <CRON_SECRET>.
# Secreta: SI (SOLO SERVIDOR, NUNCA con prefijo NEXT_PUBLIC_).
# Si falta: Las rutas /api/cron/* (notificar-busquedas, procesar-leads) responden 401 Unauthorized y los crons no pueden ejecutarse.
CRON_SECRET=

# --- Mapas (Google Maps Static API) -----------------------------------------
# Clave de Google Maps Static API para generar la imagen de zona aproximada en /imagen/zona/[id].
# Secreta: SI (SOLO SERVIDOR, NUNCA con prefijo NEXT_PUBLIC_).
# Nota: La clave DEBE ir SIN restriccion de HTTP referrer en Google Cloud Console porque la invoca el backend (fetch del servidor).
# Si falta: /imagen/zona/[id] responde 404 (sin zona ni mapa) y las fichas publicadas no muestran el mapa de la zona.
GOOGLE_MAPS_API_KEY=

# Secreto opcional para firmar criptograficamente las URLs de Google Maps Static API (URL signing secret).
# Secreta: SI (SOLO SERVIDOR, NUNCA con prefijo NEXT_PUBLIC_).
# Si falta: Las URLs de mapas estaticos se generan sin firma digital (funcionan solo con la API key, pero sin proteccion extra contra abuso de cuota si la clave se filtra).
GOOGLE_MAPS_SIGNING_SECRET=

# --- Inteligencia Artificial (Agentes) --------------------------------------
# Clave de API de OpenAI para el agente asistente inteligente (modelo por defecto: gpt-5.6-luna).
# Secreta: SI (SOLO SERVIDOR, NUNCA con prefijo NEXT_PUBLIC_).
# Si falta: Degrada automaticamente a Gemini si GEMINI_API_KEY esta configurada. Si OpenAI falla en tiempo de ejecucion,
# hace fallback a Gemini emitiendo una advertencia en logs. Si faltan ambas claves, la inferencia falla arrojando ErrorIA('IA004').
OPENAI_API_KEY=

# Clave de API de Google Gemini para inferencia de IA (modelo por defecto: gemini-3.8-flash via endpoint OpenAI-compatible).
# Secreta: SI (SOLO SERVIDOR, NUNCA con prefijo NEXT_PUBLIC_).
# Si falta: El sistema utiliza unicamente OpenAI. Si OpenAI no esta configurada o falla, no habra proveedor secundario y fallara con ErrorIA('IA004').
GEMINI_API_KEY=
