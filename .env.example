# Supabase — publicas por diseño, seguras solo porque RLS esta activo
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. SALTA RLS POR COMPLETO. Nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Conexion directa a Postgres. Solo la usan las pruebas: la de la guarda del
# seed ejecuta supabase/seed.sql de verdad, y eso no se puede por la API REST
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Marcador de entorno. 'production' bloquea la ejecucion del seed
APP_ENTORNO=local

# Usada para construir emailRedirectTo en el registro
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Turnstile de Cloudflare: captcha de registro y login. LAS DOS O NINGUNA --
# con una sola definida el captcha queda DESACTIVADO y se avisa por consola,
# porque medio Turnstile es peor que ninguno (ver src/lib/seguridad/turnstile.ts).
# Se sacan en https://dash.cloudflare.com -> Turnstile -> Add site.
# TURNSTILE_SECRET_KEY es SOLO servidor: jamas con prefijo NEXT_PUBLIC_.
# Vacias en local: sin ellas los formularios se comportan como antes de SP0.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SOLO PRODUCCION. Nombre de la cabecera que la plataforma GARANTIZA reescribir
# con la IP real del cliente, descartando la que traiga la peticion. En Vercel
# es x-vercel-forwarded-for. NO poner aqui x-forwarded-for: esa la compone
# cualquiera, y confiar en ella es el hallazgo I3.
# En local se deja vacia: fuera de produccion la IP es siempre 127.0.0.1.
# Sin configurar en produccion, el limite de intentos degrada a ventana por
# correo -- mas estricto y no falsificable -- y avisa una vez en el log.
IP_CABECERA_CONFIABLE=
