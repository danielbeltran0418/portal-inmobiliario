# Supabase — publicas por diseño, seguras solo porque RLS esta activo
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. SALTA RLS POR COMPLETO. Nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Conexion directa a Postgres. Solo la usan las pruebas: la de la guarda del
# seed ejecuta supabase/seed.sql de verdad, y eso no se puede por la API REST
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Marcador de entorno. 'production' bloquea la ejecucion del seed
APP_ENTORNO=local

# Usada para construir emailRedirectTo en el registro
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
